[Unit]
Description=Sever VPN core
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/sever/vendor
LoadCredential=xray.json:/opt/sever/config/xray.json
ExecStart=/opt/sever/vendor/xray run -config %d/xray.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
